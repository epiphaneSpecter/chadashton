---
import BaseLayout from '../layouts/BaseLayout.astro';
import Video from '../components/media/Video.astro';
import { site } from '../config/site';
import { contact } from '../config/navigation';
import { homeVideo } from '../config/home';

/** Structured data for search engines. */
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.author,
  url: Astro.site?.href,
  email: `mailto:${contact.email}`,
  jobTitle: 'Designer, illustrator and animator',
};
---

<BaseLayout bodyClass="bg-blush">
  <script is:inline type="application/ld+json" set:html={JSON.stringify(person)} />
  <main
    id="main"
    class="relative h-svh overflow-hidden"
    style={homeVideo?.background ? { backgroundColor: homeVideo.background } : undefined}
  >
    {homeVideo && (
      <Video
        name={homeVideo.name}
        poster={homeVideo.poster}
        label={homeVideo.label}
        eager
        clickable={false}
        class:list={[
          'pointer-events-none absolute inset-0 size-full',
          homeVideo.mobileFit === 'cover' ? 'object-cover' : 'object-contain',
          homeVideo.fit === 'contain' ? 'desktop:object-contain' : 'desktop:object-cover',
        ]}
        data-home-video
      />
    )}
    <h1 class="absolute top-[47.8%] left-1/2 -translate-x-1/2 -translate-y-1/2 text-hero whitespace-nowrap desktop:top-[49.9%]">
      Chad ASHTON
    </h1>
    <p class="absolute bottom-[13.3svh] left-1/2 -translate-x-1/2 text-center text-title whitespace-nowrap desktop:bottom-[8svh]">
      {site.tagline}
    </p>
    {/* The landing has no menu in the mockup: the whole screen leads to the portfolio. */}
    <a
      href="/portfolio"
      class="absolute inset-0 z-10 focus-visible:outline-2 focus-visible:-outline-offset-8 focus-visible:outline-ink"
    >
      <span class="sr-only">Enter the portfolio</span>
    </a>
    {homeVideo && (
      <div class="absolute right-[20px] bottom-[20px] z-20 flex gap-[16px] text-[14px] uppercase desktop:right-[calc(40*var(--u))] desktop:bottom-[calc(40*var(--u))] desktop:gap-[calc(32*var(--u))] desktop:text-[max(12px,calc(20*var(--u)))]">
        {/* Browsers only start a video on their own when it is muted: the sound needs a click. */}
        {homeVideo.sound && (
          <button type="button" class="uppercase" data-home-video-sound>
            Sound on
          </button>
        )}
        <button type="button" class="uppercase" data-home-video-toggle>
          Pause
        </button>
      </div>
    )}
  </main>
</BaseLayout>

<script>
  // Pause / play and sound controls of the home animation (the link above covers the video).
  function play(video: HTMLVideoElement) {
    delete video.dataset.userPaused;
    video.play().catch(() => undefined);
  }

  function init() {
    const button = document.querySelector<HTMLButtonElement>('[data-home-video-toggle]');
    const sound = document.querySelector<HTMLButtonElement>('[data-home-video-sound]');
    const video = document.querySelector<HTMLVideoElement>('video[data-home-video]');
    if (!button || !video || 'ready' in button.dataset) return;
    button.dataset.ready = '';

    const sync = () => {
      button.textContent = video.paused ? 'Play' : 'Pause';
      if (sound) {
        sound.textContent = video.muted ? 'Sound on' : 'Sound off';
      }
    };
    video.addEventListener('play', sync);
    video.addEventListener('pause', sync);
    video.addEventListener('volumechange', sync);
    sync();

    button.addEventListener('click', () => {
      if (video.paused) play(video);
      else {
        video.dataset.userPaused = '';
        video.pause();
      }
    });
    sound?.addEventListener('click', () => {
      video.muted = !video.muted;
      // Turning the sound on means the visitor wants to hear it: start the video if it was paused.
      if (!video.muted && video.paused) play(video);
    });
  }

  init();
  document.addEventListener('astro:page-load', init);
</script>
