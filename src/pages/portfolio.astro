---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AshtonFontLink from '../components/AshtonFontLink.astro';
import CategoryPreview from '../components/CategoryPreview.astro';
import { categories, categoryHref, type CategorySlug } from '../config/categories';

// Desktop x position of each label (mockup px at 1920), the spacing is irregular in the mockup.
const desktopLeft: Record<string, string> = {
  design: 'desktop:left-[calc(446*var(--u))]',
  illustration: 'desktop:left-[calc(861*var(--u))]',
  animation: 'desktop:left-[calc(1297*var(--u))]',
};

/**
 * Hover state of the XD prototype (desktop): a portrait preview appears above the label, the label
 * slides down and a tagline appears (0.3 s, ease-out). Texts verbatim from the prototype.
 */
const taglines: Record<CategorySlug, string> = {
  design: 'Where style and function shake hands',
  illustration: 'Louder than words',
  animation: 'The possibilities are endless from here',
};
---

<BaseLayout
  title="Portfolio"
  description="Portfolio of Chad Ashton (C. ASHTON): design, illustration and animation."
>
  <Header />
  <main id="main" class="relative desktop:h-[calc(1019*var(--u))]">
    <h1 class="sr-only">Portfolio</h1>
    <ul class="mt-[118px] flex flex-col items-center gap-[133px] text-[23px] leading-[1.1] uppercase desktop:m-0 desktop:text-[calc(30*var(--u))]">
      {categories.map((category) => (
        <li
          class:list={[
            'desktop:absolute desktop:top-[calc(457*var(--u))]',
            desktopLeft[category.slug],
          ]}
        >
          <a
            href={categoryHref(category.slug)}
            class="group relative block focus-visible:outline-none"
          >
            <CategoryPreview
              slug={category.slug}
              class="absolute top-[calc(-233*var(--u))] left-1/2 h-[calc(346*var(--u))] w-[calc(242*var(--u))] -translate-x-1/2"
            />
            <span class="relative block transition-transform duration-300 ease-out group-hover:underline-active group-focus-visible:underline-active motion-reduce:transition-none desktop:group-hover:translate-y-[calc(135*var(--u))] desktop:group-focus-visible:translate-y-[calc(135*var(--u))]">
              {category.label}
            </span>
            <span
              class="pointer-events-none absolute top-[calc(195*var(--u))] left-1/2 hidden -translate-x-1/2 text-[max(12px,calc(20*var(--u)))] leading-[1.1] whitespace-nowrap normal-case opacity-0 transition-opacity duration-300 ease-out group-hover:opacity-100 group-focus-visible:opacity-100 desktop:block"
              aria-hidden="true"
            >
              {taglines[category.slug]}
            </span>
          </a>
        </li>
      ))}
    </ul>
    <AshtonFontLink
      hoverAsteriskClass="text-pink"
      class="mt-[164px] desktop:absolute desktop:top-[calc(823*var(--u))] desktop:right-0 desktop:m-0"
    />
  </main>
  <Footer spacious class="mt-[159px] desktop:mt-0" />
</BaseLayout>
