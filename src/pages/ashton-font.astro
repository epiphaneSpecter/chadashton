---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import FontText from '../components/FontText.astro';
import AsteriskIcon from '../components/icons/AsteriskIcon.astro';
import { ashtonFont as t, technicalView as tv } from '../data/ashton-font';
import alphabet from '../assets/ashton-font/uppercase-alphabet.jpg';
import trouser from '../assets/ashton-font/trouser-society-unicycle.jpg';
import postOffice from '../assets/ashton-font/post-office.jpg';
import indoorSquash from '../assets/ashton-font/indoor-squash.jpg';
// PLACEHOLDER: construction diagrams cropped from the mockup (vector drawings to export from XD as SVG).
import piO from '../assets/ashton-font/construction-pi-o-from-mockup.png';
import shapes from '../assets/ashton-font/construction-shapes-from-mockup.png';
import hTemplate from '../assets/ashton-font/construction-h-from-mockup.png';
import italicH from '../assets/ashton-font/italic-h-from-mockup.png';
import italicAngle from '../assets/ashton-font/italic-angle-from-mockup.png';

/**
 * Presentation of the Ashton font (no sale in v1). Two states switched by the "BLUPRINT MODE"
 * toggle: the font itself (default) and its "Technical View" (construction of the glyphs).
 * Desktop: elements placed as in the 1920 px mockup (`at(x, y, width)` in mockup px).
 * Mobile: stacked as in the 393 px mockup.
 */
const at = (x: number, y: number, w?: number, tracking?: number) => ({
  '--x': x,
  '--y': y,
  '--w': w,
  '--tr': tracking === undefined ? undefined : `${tracking}em`,
});
const D =
  'desktop:absolute desktop:top-[calc(var(--y)*var(--u))] desktop:left-[calc(var(--x)*var(--u))] desktop:m-0';
const W = 'desktop:w-[calc(var(--w)*var(--u))]';
const exitHref = '/portfolio';
---

<BaseLayout
  title="Ashton font"
  description="The Ashton font by Chad Ashton: a geometric, intensely italic sans-serif based on his handwriting."
  bodyClass="bg-black"
>
  <div
    class="ashton relative bg-black text-cream data-[blueprint=on]:bg-cream data-[blueprint=on]:text-ink desktop:h-[calc(4226*var(--u))]"
    data-blueprint="off"
    data-ashton-font
  >
    <div class="absolute inset-x-0 top-0 z-10">
      <Header />
    </div>

    <main id="main">
      {/* Hero: same layout in both states, outlined in the Technical View. */}
      <section
        class="relative flex flex-col items-center pt-[167px] desktop:static desktop:block desktop:p-0"
        aria-labelledby="font-title"
      >
        <h1
          id="font-title"
          class:list={[
            'outline-text pl-[12px] text-[102px] leading-[1.1] tracking-[-0.01em] text-pink desktop:text-[calc(326*var(--u))] desktop:tracking-[-0.008em] desktop:pl-[calc(48*var(--u))]',
            D,
            W,
            'desktop:text-center',
          ]}
          style={at(0, 215, 1920)}
        >
          {t.title}
        </h1>
        <hr
          class:list={[
            'rule -mt-[11px] h-px w-[min(323px,calc(100vw-70px))] border-0 bg-cream/55 desktop:h-[calc(4*var(--u))] desktop:bg-cream',
            D,
            W,
          ]}
          style={at(440, 542, 1040)}
        />

        {/* Desktop only: vertical words and rules around the tagline. */}
        <p class:list={['hidden desktop:flex', D]} style={at(489, 607)}>
          <span class="sr-only">{t.inProgress.join(' ')}</span>
          {t.inProgress.map((word) => (
            <span
              class="outline-text flex w-[calc(30*var(--u))] flex-col items-center text-[calc(28*var(--u))] leading-[calc(32*var(--u))] desktop:mr-[calc(20*var(--u))]"
              aria-hidden="true"
            >
              {[...word].map((letter) => (
                <span>{letter}</span>
              ))}
            </span>
          ))}
        </p>
        <span
          class:list={[
            'rule hidden h-[calc(388*var(--u))] w-[calc(4*var(--u))] bg-cream desktop:block',
            D,
          ]}
          style={at(648, 591)}
        ></span>
        <span
          class:list={[
            'rule hidden h-[calc(388*var(--u))] w-[calc(4*var(--u))] bg-cream desktop:block',
            D,
          ]}
          style={at(1268, 591)}
        ></span>

        <p
          class:list={[
            'outline-text mt-[33px] text-[33px] leading-[1.1] whitespace-nowrap desktop:text-center desktop:text-[calc(65*var(--u))] desktop:pl-[calc(14*var(--u))]',
            D,
            W,
          ]}
          style={at(0, 633, 1920)}
        >
          S<span class="text-[23px] desktop:text-[calc(46*var(--u))]">LEEK</span>{' '}
          <span
            class="inline-block text-[19px] desktop:text-[calc(36*var(--u))]"
            aria-hidden="true"
          >
            <span class="relative -top-[14px] desktop:-top-[calc(28*var(--u))]">A</span>
            <span class="relative -top-px desktop:-top-[calc(2*var(--u))]">N</span>
            <span class="relative top-[11px] desktop:top-[calc(23*var(--u))]">D</span>
          </span>
          <span class="sr-only">and</span> S
          <span class="text-[23px] desktop:text-[calc(46*var(--u))]">LANTED</span>
        </p>
        <p
          class:list={[
            'outline-text mt-[34px] text-[17px] leading-[1.1] tracking-[-0.013em] desktop:text-center desktop:text-[calc(33*var(--u))] desktop:tracking-[-0.005em]',
            D,
            W,
          ]}
          style={at(0, 769, 1920)}
        >
          {t.tagline}
        </p>
        <p
          class:list={[
            'outline-text mt-[8px] text-[18px] leading-[1.1] tracking-[-0.05em] desktop:text-center desktop:text-[calc(33*var(--u))] desktop:tracking-[-0.01em]',
            D,
            W,
          ]}
          style={at(0, 817, 1920)}
        >
          {t.through}
        </p>
        <p
          class:list={[
            'designed hidden h-[calc(40*var(--u))] bg-cream text-center text-[calc(35*var(--u))] leading-[calc(40*var(--u))] whitespace-nowrap text-ink desktop:block',
            D,
            W,
          ]}
          style={at(781, 928, 357)}
        >
          <span class="outline-text">{t.designedBy}</span>
        </p>
        <hr
          class:list={[
            'rule mt-[28px] h-px w-[min(323px,calc(100vw-70px))] border-0 bg-cream/55 desktop:hidden',
            D,
          ]}
        />

        {/* Toggle: vertical and fixed on the right edge on mobile, under the hero on desktop. */}
        <div class="fixed right-[18.5px] bottom-[129px] z-30 flex translate-x-1/2 translate-y-1/2 -rotate-90 items-center gap-[8px] font-futura not-italic desktop:absolute desktop:top-[calc(989*var(--u))] desktop:right-auto desktop:bottom-auto desktop:left-[calc(1733*var(--u))] desktop:w-[calc(139*var(--u))] desktop:translate-0 desktop:rotate-0 desktop:flex-col desktop:gap-[calc(13*var(--u))]">
          <span
            id="blueprint-label"
            class="text-[12px] leading-none font-medium whitespace-nowrap uppercase desktop:text-[max(12px,calc(20*var(--u)))]"
          >
            {t.toggle}
          </span>
          <button
            type="button"
            role="switch"
            aria-checked="false"
            aria-labelledby="blueprint-label blueprint-state"
            class="toggle relative flex h-[20px] w-[46px] items-center rounded-full bg-cream px-[2px] text-ink desktop:h-[calc(30*var(--u))] desktop:w-[calc(88*var(--u))] desktop:px-[calc(3*var(--u))]"
            data-blueprint-toggle
          >
            <span
              class="knob size-[16px] rounded-full bg-ink desktop:size-[calc(24*var(--u))]"
              aria-hidden="true"
            ></span>
            <span
              class="state flex-1 text-center text-[13px] leading-none uppercase desktop:text-[max(12px,calc(22*var(--u)))]"
              id="blueprint-state"
              data-off="OFF"
              data-on="ON"
            >
              OFF
            </span>
          </button>
        </div>
      </section>

      {/* ---------------- Default state: the font ---------------- */}
      <div class="flex flex-col items-start pl-[14px] desktop:contents" data-state="off">
        <section
          class="mt-[48px] w-[min(343px,calc(100vw-50px))] desktop:absolute desktop:top-[calc(1092*var(--u))] desktop:left-0 desktop:m-0 desktop:flex desktop:h-[calc(1182*var(--u))] desktop:w-full desktop:justify-center desktop:bg-cream"
          aria-label="Uppercase alphabet"
        >
          <Image
            src={alphabet}
            alt={`The 26 capital letters of the Ashton font, A to Z, with the caption "${t.alphabetCaption}"`}
            class="block aspect-square w-[min(343px,calc(100vw-50px))] object-cover desktop:size-[calc(1184*var(--u))]"
            widths={[343, 686, 1184, 1798]}
            sizes="(min-width: 1024px) 62vw, 343px"
          />
        </section>

        <ul
          class="mt-[14px] flex flex-col desktop:contents"
          aria-label="Lettering made with the Ashton font"
        >
          {[
            {
              src: trouser,
              alt: 'Trouser Society Unicycle, in white letters on purple',
              x: 252,
              mobile: true,
            },
            {
              src: postOffice,
              alt: 'Official Post Office, est. 1967, branding design',
              x: 743,
              mobile: false,
            },
            {
              src: indoorSquash,
              alt: 'Indoor Squash ultimate league, tournament starts June 22nd 1972',
              x: 1235,
              mobile: false,
            },
          ].map((card) => (
            <li class:list={[!card.mobile && 'hidden desktop:block', D]} style={at(card.x, 2400)}>
              <Image
                src={card.src}
                alt={card.alt}
                class="block aspect-square w-[min(343px,calc(100vw-50px))] object-cover desktop:size-[calc(433*var(--u))]"
                widths={[343, 433, 686, 866]}
                sizes="(min-width: 1024px) 23vw, 343px"
              />
            </li>
          ))}
        </ul>

        <section
          class="relative mt-[39px] w-full pl-[47px] desktop:contents"
          aria-labelledby="font-properties"
        >
          <h2
            id="font-properties"
            class="absolute top-[261px] left-[6px] origin-top-left -rotate-90 text-[24px] leading-none tracking-[0.04em] whitespace-nowrap desktop:sr-only"
          >
            {t.propertiesTitle.join(' ')}
          </h2>
          <p
            class:list={[
              'hidden text-right text-[calc(86*var(--u))] leading-[calc(123*var(--u))] tracking-[-0.005em] desktop:block',
              D,
              W,
            ]}
            style={at(400, 2955, 575)}
            aria-hidden="true"
          >
            {t.propertiesTitle[0]}
            <br />
            {t.propertiesTitle[1]}
          </p>
          <ul
            class:list={[
              'text-[28px] leading-[44px] desktop:text-[calc(48*var(--u))] desktop:leading-[calc(76*var(--u))]',
              D,
            ]}
            style={at(1164, 2952)}
          >
            {t.properties.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
          <span
            class:list={['mt-[37px] block size-[29px] desktop:size-[calc(48*var(--u))]', D]}
            style={at(1164, 3245)}
          >
            <AsteriskIcon variant="burger" class="size-full" />
          </span>
          <ul
            class:list={[
              'mt-[40px] text-[25px] leading-[34px] desktop:text-[calc(48*var(--u))] desktop:leading-[calc(61.33*var(--u))] desktop:tracking-[-0.033em]',
              D,
            ]}
            style={at(1164, 3376)}
          >
            {t.influences.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </section>

        {/* Letter tiles Aa / Nn / Zz (not provided as images: drawn in HTML from the mockup). */}
        <div
          class:list={[
            'mt-[86px] ml-[18px] flex text-[60px] leading-none desktop:text-[calc(130*var(--u))]',
            D,
          ]}
          style={at(267, 3248)}
          aria-hidden="true"
        >
          <span class="relative flex size-[min(109px,calc((100vw-66px)/3))] items-center justify-center bg-[#51430a] text-[#f2eaf4] desktop:h-[calc(244*var(--u))] desktop:w-[calc(244*var(--u))]">
            <span class="absolute inset-[4px] border border-[#f2eaf4]/70 desktop:inset-[calc(10*var(--u))]"></span>
            <span class="absolute inset-x-[4px] top-[21px] bottom-[21px] border-y border-[#f2eaf4]/70 desktop:inset-x-[calc(10*var(--u))] desktop:top-[calc(56*var(--u))] desktop:bottom-[calc(56*var(--u))]"></span>
            <span class="relative">Aa</span>
          </span>
          <span class="flex size-[min(109px,calc((100vw-66px)/3))] items-center justify-center bg-[#1c1c12] desktop:h-[calc(244*var(--u))] desktop:w-[calc(244*var(--u))]">
            <span class="flex size-[min(89px,calc((100vw-66px)/3-20px))] items-center justify-center rounded-[12px] bg-[#fdfcee] text-[0.75em] text-[#1c1c12] desktop:size-[calc(224*var(--u))] desktop:rounded-[calc(28*var(--u))]">
              Nn
            </span>
          </span>
          <span class="relative flex size-[min(109px,calc((100vw-66px)/3))] items-center justify-center bg-[#42033e] text-[#f9eaf8] desktop:h-[calc(244*var(--u))] desktop:w-[calc(250*var(--u))]">
            <span class="absolute inset-[4px] border-2 border-[#f7bfec] desktop:inset-[calc(10*var(--u))] desktop:border-[calc(4*var(--u))]"></span>
            <span class="relative">Zz</span>
          </span>
        </div>

        <p
          class:list={[
            'mt-[99px] -ml-[14px] w-[calc(100%+14px)] text-center text-[14px] leading-[22px] tracking-[0.06em] desktop:text-[calc(33*var(--u))] desktop:leading-[calc(44*var(--u))] desktop:tracking-[-0.01em] desktop:pr-[calc(46*var(--u))]',
            D,
            W,
          ]}
          style={at(0, 3858, 1920)}
        >
          {t.idea.mobile.map((line, index) => (
            <span class="desktop:hidden">
              {index > 0 && <br />}
              {line}
            </span>
          ))}
          {t.idea.desktop.map((line, index) => (
            <span class="hidden desktop:inline">
              {index > 0 && <br />}
              {line}
            </span>
          ))}
        </p>
      </div>

      {/* ---------------- Technical View (BLUPRINT MODE on) ---------------- */}
      <div class="flex flex-col items-start pl-[14px] desktop:contents" data-state="on" hidden>
        <section
          class="mt-[48px] flex flex-col gap-[14px] desktop:absolute desktop:top-[calc(1092*var(--u))] desktop:left-0 desktop:m-0 desktop:block desktop:h-[calc(1182*var(--u))] desktop:w-full desktop:bg-black"
          aria-label="Construction of the glyphs"
        >
          <hr
            class:list={['hidden h-px border-0 bg-cream desktop:block', D, W]}
            style={at(243, 73, 1415)}
          />
          {/* Card 1 (mobile) / first row (desktop). */}
          <div class="relative aspect-square w-[min(343px,calc(100vw-50px))] bg-black desktop:aspect-auto px-[21px] pt-[24px] text-cream desktop:static desktop:h-auto desktop:w-auto desktop:bg-transparent desktop:p-0">
            <p
              class:list={[
                'desktop:tracking-(--tr) text-[14px] leading-[16px] tracking-[0.04em] desktop:text-[calc(33*var(--u))] desktop:leading-[calc(44*var(--u))]',
                D,
              ]}
              style={at(240, 232, undefined, -0.012)}
            >
              {tv.geometric.mobile.map((line, index) => (
                <span class="desktop:hidden">
                  {index > 0 && <br />}
                  {line}
                </span>
              ))}
              {tv.geometric.desktop.map((line, index) => (
                <span class="hidden desktop:inline">
                  {index > 0 && <br />}
                  {line}
                </span>
              ))}
            </p>
            <Image
              src={piO}
              alt="The handwritten r (π) and the letter o built from a slanted parallelogram and an ellipse"
              class:list={['mx-auto mt-[33px] block w-[186px] desktop:w-[calc(407*var(--u))]', D]}
              style={at(761, 197)}
              widths={[372, 407]}
              sizes="(min-width: 1024px) 21vw, 186px"
              data-placeholder="image"
            />
            <p
              class:list={[
                'desktop:tracking-(--tr) absolute bottom-[34px] left-[21px] text-[14px] leading-[16px] tracking-[0.04em] desktop:bottom-auto desktop:text-[calc(33*var(--u))] desktop:leading-[calc(40*var(--u))]',
                D,
              ]}
              style={at(1224, 256, undefined, -0.006)}
            >
              {tv.grid.mobile.map((line, index) => (
                <span class="desktop:hidden">
                  {index > 0 && <br />}
                  {line}
                </span>
              ))}
              {tv.grid.desktop.map((line, index) => (
                <span class="hidden desktop:inline">
                  {index > 0 && <br />}
                  <FontText text={line} />
                </span>
              ))}
            </p>
          </div>
          <hr
            class:list={['hidden h-[calc(2*var(--u))] border-0 bg-[#7e7e77] desktop:block', D, W]}
            style={at(243, 585, 1415)}
          />
          <hr
            class:list={['hidden h-px border-0 bg-cream desktop:block', D, W]}
            style={at(243, 642, 1415)}
          />
          {/* Card 2 (mobile) / second row (desktop). */}
          <div class="relative aspect-square w-[min(343px,calc(100vw-50px))] bg-black desktop:aspect-auto px-[21px] pt-[17px] text-cream desktop:static desktop:h-auto desktop:w-auto desktop:bg-transparent desktop:p-0">
            <p
              class:list={[
                'desktop:tracking-(--tr) text-[14px] leading-[16px] tracking-[0.04em] desktop:text-[calc(33*var(--u))] desktop:leading-[calc(44*var(--u))]',
                D,
              ]}
              style={at(240, 800, undefined, -0.013)}
            >
              {tv.traces.mobile.map((line, index) => (
                <span class="desktop:hidden">
                  {index > 0 && <br />}
                  {line}
                </span>
              ))}
              {tv.traces.desktop.map((line, index) => (
                <span class="hidden desktop:inline">
                  {index > 0 && <br />}
                  <FontText text={line} />
                </span>
              ))}
            </p>
            <Image
              src={shapes}
              alt="A slanted parallelogram and an ellipse drawn in magenta outlines"
              class:list={['mx-auto mt-[32px] block w-[236px] desktop:w-[calc(441*var(--u))]', D]}
              style={at(731, 779)}
              widths={[441, 472]}
              sizes="(min-width: 1024px) 23vw, 236px"
              data-placeholder="image"
            />
            <p
              class:list={[
                'desktop:tracking-(--tr) absolute bottom-[86px] left-[21px] text-[14px] leading-none tracking-[0.04em] desktop:bottom-auto desktop:text-[calc(33*var(--u))]',
                D,
              ]}
              style={at(1345, 715, undefined, -0.014)}
            >
              {tv.forInstance}
            </p>
            <Image
              src={hTemplate}
              alt="The letter H drawn over the parallelogram template"
              class:list={[
                'absolute right-[85px] bottom-[28px] block w-[127px] desktop:right-auto desktop:bottom-auto desktop:w-[calc(293*var(--u))]',
                D,
              ]}
              style={at(1276, 818)}
              widths={[254, 293]}
              sizes="(min-width: 1024px) 15vw, 127px"
              data-placeholder="image"
            />
          </div>
          <hr
            class:list={['hidden h-px border-0 bg-cream desktop:block', D, W]}
            style={at(243, 1127, 1415)}
          />
        </section>

        <section
          class="mt-[28px] -ml-[14px] flex w-[calc(100%+14px)] flex-col items-center desktop:contents"
          aria-label="Italics"
        >
          <p
            class:list={[
              'desktop:tracking-(--tr) text-center text-[14px] leading-[16px] tracking-[0.04em] desktop:text-[calc(33*var(--u))] desktop:leading-[calc(44*var(--u))]',
              D,
              W,
            ]}
            style={at(0, 2571, 1920, -0.014)}
          >
            {tv.italics.mobile.map((line, index) => (
              <span class="desktop:hidden">
                {index > 0 && <br />}
                {line}
              </span>
            ))}
            {tv.italics.desktop.map((line, index) => (
              <span class="hidden desktop:inline">
                {index > 0 && <br />}
                {line}
              </span>
            ))}
          </p>
          <span
            class:list={[
              'hidden h-[calc(473*var(--u))] w-[calc(2*var(--u))] bg-[#888886] desktop:block',
              D,
            ]}
            style={at(486, 2725)}
          ></span>
          <span
            class:list={[
              'hidden h-[calc(451*var(--u))] w-[calc(2*var(--u))] bg-[#b7b6b0] desktop:block',
              D,
            ]}
            style={at(1414, 2736)}
          ></span>
          <Image
            src={italicH}
            alt="A grey italic H on its baseline, with the slant line of the letter"
            class:list={[
              'mt-[39px] -translate-x-[6px] block w-[174px] desktop:translate-x-0 desktop:w-[calc(373*var(--u))]',
              D,
            ]}
            style={at(776, 2721)}
            widths={[348, 373]}
            sizes="(min-width: 1024px) 20vw, 174px"
            data-placeholder="image"
          />
          <div
            class:list={[
              'mt-[22px] flex -translate-x-[10px] items-end gap-[16px] desktop:translate-x-0 desktop:gap-[calc(32*var(--u))]',
              D,
            ]}
            style={at(740, 3056)}
          >
            <Image
              src={italicAngle}
              alt="Angle of the italic slant"
              class="block w-[46px] desktop:w-[calc(104*var(--u))]"
              widths={[104]}
              sizes="(min-width: 1024px) 6vw, 46px"
              data-placeholder="image"
            />
            <p class="mb-[6px] text-[20px] leading-none tracking-[0.04em] desktop:mb-[calc(25*var(--u))] desktop:text-[calc(48*var(--u))] desktop:tracking-[-0.008em]">
              {tv.angle}
            </p>
          </div>
          <p
            class:list={[
              'desktop:tracking-(--tr) mt-[40px] text-center text-[14px] leading-[16px] tracking-[0.04em] desktop:text-[calc(33*var(--u))] desktop:leading-[calc(44*var(--u))]',
              D,
              W,
            ]}
            style={at(0, 3259, 1920, -0.013)}
          >
            {tv.intensely.mobile.map((line, index) => (
              <span class="desktop:hidden">
                {index > 0 && <br />}
                {line}
              </span>
            ))}
            {tv.intensely.desktop.map((line, index) => (
              <span class="hidden desktop:inline">
                {index > 0 && <br />}
                {line}
              </span>
            ))}
          </p>
          <p
            class:list={[
              'desktop:tracking-(--tr) hidden text-center text-[calc(16*var(--u))] leading-none desktop:block',
              D,
              W,
            ]}
            style={at(0, 3402, 1920, -0.035)}
          >
            <a href={tv.source.href} target="_blank" rel="noopener noreferrer">
              {tv.source.label}
            </a>
          </p>

          <div class="mt-[50px] flex w-[min(305px,calc(100vw-74px))] translate-x-[3px] justify-between desktop:contents">
            {[
              {
                glyphs: ['{r}', 'r'],
                lines: tv.alternateR,
                x: 244,
                label: 'The handwritten r becomes the regular r',
              },
              {
                glyphs: ['{s}', 'S'],
                lines: tv.alternateS,
                x: 1444,
                label: 'The handwritten s becomes the S',
              },
            ].map((column) => (
              <div class:list={['w-[120px] desktop:w-auto', D]} style={at(column.x, 2814)}>
                <p
                  class="flex items-baseline gap-[6px] text-[45px] leading-none [-webkit-text-stroke:0.03em_currentColor] desktop:gap-[calc(14*var(--u))] desktop:text-[calc(79*var(--u))]"
                  aria-label={column.label}
                >
                  {/* The alternates are shown at the x-height of the capitals, as in the mockup. */}
                  <span class="text-[1.25em]">
                    <FontText text={column.glyphs[0] ?? ''} />
                  </span>
                  <svg
                    class="mb-[0.17em] w-[18px] desktop:w-[calc(32*var(--u))]"
                    viewBox="0 0 32 20"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="3.5"
                    aria-hidden="true"
                  >
                    <path d="M0 10h28M20 2l9 8-9 8" />
                  </svg>
                  <span class:list={[column.glyphs[1] === 'r' && 'text-[1.25em]']}>
                    {column.glyphs[1]}
                  </span>
                </p>
                <p class="mt-[10px] text-[13px] leading-[19.5px] tracking-[0.04em] desktop:-mt-[calc(2*var(--u))] desktop:text-[calc(27*var(--u))] desktop:leading-[calc(32*var(--u))] desktop:tracking-[-0.02em]">
                  {column.lines.map((line, index) => (
                    <>
                      {index > 0 && <br />}
                      <FontText text={line} />
                    </>
                  ))}
                </p>
              </div>
            ))}
          </div>

          <p
            class:list={[
              'desktop:tracking-(--tr) mt-[53px] text-center text-[14px] leading-[22px] tracking-[0.06em] desktop:text-[calc(33*var(--u))] desktop:leading-[calc(44*var(--u))]',
              D,
              W,
            ]}
            style={at(0, 3860, 1920, -0.013)}
          >
            {tv.curious.mobile.map((line, index) => (
              <span class="desktop:hidden">
                {index > 0 && <br />}
                {line}
              </span>
            ))}
            {tv.curious.desktop.map((line, index) => (
              <span class="hidden desktop:inline">
                {index > 0 && <br />}
                {line}
              </span>
            ))}
          </p>
        </section>
      </div>

      <p
        class:list={['mt-[110px] pb-[76px] text-center desktop:pb-0', D, W]}
        style={at(0, 4050, 1920)}
      >
        <a
          href={exitHref}
          class="text-[44px] leading-[1.1] underline decoration-1 underline-offset-[6px] desktop:text-[calc(51*var(--u))] desktop:no-underline"
        >
          EXIT
        </a>
      </p>
    </main>
  </div>
</BaseLayout>

<style>
  /* Technical View: the hero texts become outlines, the rules thin double strokes. */
  [data-blueprint='on'] .outline-text {
    color: transparent;
    -webkit-text-stroke: 1px var(--color-ink);
  }

  /* Mobile mockup: lighter grey outlines. */
  @media (width < 64rem) {
    [data-blueprint='on'] .outline-text {
      -webkit-text-stroke-color: #656560;
    }
  }

  [data-blueprint='on'] .rule {
    background: transparent;
    border: 1px solid var(--color-ink);
  }

  [data-blueprint='on'] .designed {
    background: transparent;
    outline: 1px solid var(--color-ink);
    outline-offset: -1px;
  }

  [data-blueprint='on'] .toggle {
    flex-direction: row-reverse;
    background: var(--color-ink);
    color: var(--color-cream);
  }

  [data-blueprint='on'] .knob {
    background: var(--color-cream);
  }
</style>

<script>
  function init() {
    const page = document.querySelector<HTMLElement>('[data-ashton-font]');
    const toggle = page?.querySelector<HTMLButtonElement>('[data-blueprint-toggle]');
    if (!page || !toggle || 'ready' in toggle.dataset) return;
    toggle.dataset.ready = '';
    const state = toggle.querySelector<HTMLElement>('.state');

    toggle.addEventListener('click', () => {
      const on = toggle.getAttribute('aria-checked') !== 'true';
      toggle.setAttribute('aria-checked', String(on));
      page.dataset.blueprint = on ? 'on' : 'off';
      if (state) state.textContent = (on ? state.dataset.on : state.dataset.off) ?? '';
      page.querySelectorAll<HTMLElement>('[data-state]').forEach((block) => {
        block.hidden = block.dataset.state !== (on ? 'on' : 'off');
      });
    });
  }

  init();
  document.addEventListener('astro:page-load', init);
</script>
