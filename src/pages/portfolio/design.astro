---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import AshtonFontLink from '../../components/AshtonFontLink.astro';
import CategoryNav from '../../components/CategoryNav.astro';
import { projectHref } from '../../config/categories';
// PLACEHOLDER: crop of the mockup, the original "You Give Me" artwork was not provided.
import youGiveMe from '../../assets/projects/miles-clayton/you-give-me-from-mockup.png';
import indoorSquash from '../../assets/projects/ashton-font/indoor-squash.png';

const projects = (await getCollection('projects', ({ data }) => data.category === 'design')).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<BaseLayout title="Design" bodyClass="bg-green pb-[56px] desktop:pb-0">
  <div class="bg-ink pb-[42px] text-paper desktop:pb-[calc(148*var(--u))]">
    <Header />
    <main>
      <h1 class="sr-only">Design</h1>
      <figure class="mx-[28px] mt-[39px] desktop:mx-0 desktop:mt-[calc(73*var(--u))] desktop:flex desktop:items-end desktop:pl-[calc(615*var(--u))]">
        <a href={projectHref('design', 'miles-clayton')} class="block">
          <Image
            src={youGiveMe}
            alt="You Give Me, single artwork for Miles Clayton"
            class="block aspect-square w-full desktop:w-[calc(691*var(--u))]"
            widths={[337, 674, 691]}
            sizes="(min-width: 1024px) 36vw, 337px"
            loading="eager"
          />
        </a>
        <figcaption class="mt-[9px] text-[8px] leading-[10px] desktop:mt-0 desktop:mb-[calc(7*var(--u))] desktop:ml-[calc(31*var(--u))] desktop:text-[calc(20*var(--u))] desktop:leading-[calc(22*var(--u))]">
          You Give Me
          <br />
          Single artwork for Miles Clayton
          <br />
          <span class="text-[7px] desktop:text-[calc(16*var(--u))] desktop:leading-[calc(32*var(--u))]">
            (Latest project)
          </span>
        </figcaption>
      </figure>

      <ul class="mt-[42px] grid grid-cols-2 gap-x-[10px] gap-y-[16px] px-[20px] desktop:mt-[calc(164*var(--u))] desktop:grid-cols-4 desktop:gap-x-[calc(17*var(--u))] desktop:gap-y-[calc(73*var(--u))] desktop:pr-[calc(136*var(--u))] desktop:pl-[calc(137*var(--u))]">
        {projects.map((project) => (
          <li
            class="order-(--mobile-order) text-center desktop:order-none"
            style={{ '--mobile-order': project.data.mobileOrder ?? project.data.order }}
          >
            <a href={projectHref('design', project.id)} class="group block">
              {project.data.thumbnail && (
                <Image
                  src={project.data.thumbnail}
                  alt={project.data.thumbnailAlt ?? project.data.title}
                  class="aspect-[170/126] w-full object-cover desktop:aspect-[400/289]"
                  widths={[170, 340, 400, 800]}
                  sizes="(min-width: 1024px) 21vw, 170px"
                />
              )}
              <span class="mt-[8px] block text-[11px] leading-[1.1] group-hover:underline desktop:mt-[calc(20*var(--u))] desktop:text-[calc(26*var(--u))]">
                {project.data.cardLabel ?? project.data.title}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </main>
  </div>

  <div class="text-paper desktop:pb-[calc(13*var(--u))]">
    <Image
      src={indoorSquash}
      alt="Indoor Squash poster set in the Ashton typeface"
      class="mx-auto mt-[42px] w-[300px] desktop:mt-[calc(182*var(--u))] desktop:w-[calc(646*var(--u))]"
      widths={[288, 576, 617, 1234]}
      sizes="(min-width: 1024px) 32vw, 288px"
    />
    <AshtonFontLink
      desktopLabel="Ashton font display catalogue"
      class="mt-[73px] desktop:-mt-[calc(13*var(--u))]"
    />
    <div class="mt-[149px] desktop:mt-[calc(430*var(--u))]">
      <CategoryNav current="design" barClass="bg-ink text-paper" />
    </div>
    <Footer class="mt-[118px] desktop:mt-[calc(380*var(--u))] [&_hr]:bg-paper" />
  </div>
</BaseLayout>
