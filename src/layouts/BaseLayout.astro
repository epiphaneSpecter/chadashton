---
import '../styles/global.css';
import PageTransitions from '../components/PageTransitions.astro';
import { site } from '../config/site';

interface Props {
  title?: string;
  description?: string;
  /** Extra classes for <body>, e.g. the page background color. */
  bodyClass?: string;
}

const { title, description = site.description, bodyClass = '' } = Astro.props;
const pageTitle = title ? `${title} | ${site.name}` : `${site.author} | ${site.tagline}`;
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link
      rel="preload"
      href="/fonts/ca-scholar-v2-italic.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <PageTransitions />
  </head>
  <body class={bodyClass}>
    <slot />
  </body>
</html>
