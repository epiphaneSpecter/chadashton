---
import AsteriskIcon from './icons/AsteriskIcon.astro';

interface Props {
  /** Desktop label at the left of the row (plain text: on desktop only the circled asterisk is the link). */
  desktopLabel?: string;
  /** Color class of the asterisk on hover (by default it is cut out to the page background). */
  hoverAsteriskClass?: string;
  class?: string;
}

const { desktopLabel, hoverAsteriskClass, class: className } = Astro.props;
const href = '/ashton-font';
---

<div
  class:list={[
    'flex items-center justify-center desktop:justify-between desktop:pr-[calc(141*var(--u))] desktop:pl-[calc(140*var(--u))]',
    className,
  ]}
>
  {desktopLabel && (
    <span class="hidden text-[calc(28*var(--u))] desktop:inline">{desktopLabel}</span>
  )}
  {/* Mobile: the whole row is the link. Desktop: the asterisk is the link, and its hover
      (or keyboard focus) reveals "discover The Ashton Font" at its left. */}
  <a href={href} class="group flex items-center desktop:ml-auto">
    <span class="flex items-baseline gap-[10px] desktop:pointer-events-none desktop:mr-[calc(42*var(--u))] desktop:gap-[calc(14*var(--u))] desktop:opacity-0 desktop:transition-opacity desktop:group-hover:pointer-events-auto desktop:group-hover:opacity-100 desktop:group-focus-visible:opacity-100">
      <span class="text-[14px] desktop:text-[calc(18*var(--u))]">discover</span>
      <span class="text-[20px] desktop:text-[calc(28*var(--u))]">The Ashton Font</span>
    </span>
    <AsteriskIcon
      variant="circled"
      hoverAsteriskClass={hoverAsteriskClass}
      class="ml-[26px] size-[43px] desktop:ml-0 desktop:size-[calc(55*var(--u))]"
    />
  </a>
</div>
