---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

/**
 * Long video hosted on YouTube. Renders a link with the poster (works without JavaScript);
 * the click swaps it for the privacy-enhanced player, so nothing loads from YouTube before.
 */
interface Props {
  id: string;
  poster: ImageMetadata;
  /** Video title, used for the link and the iframe. */
  label: string;
  sizes?: string;
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { id, poster, label, sizes, class: className, style } = Astro.props;
/** The link positions the play icon: relative, unless the caller already positions it. */
const positioned = /(^|\s)(absolute|fixed|relative|sticky)(\s|$)/.test(className ?? '');
---

<a
  href={`https://www.youtube.com/watch?v=${id}`}
  class:list={[className, !positioned && 'relative', 'group aspect-video overflow-hidden']}
  style={style}
  data-youtube={id}
  data-label={label}
  aria-label={`Play on YouTube: ${label}`}
>
  <Image
    src={poster}
    alt=""
    class="size-full object-cover"
    widths={[400, 800, 1200, 1920]}
    sizes={sizes}
  />
  {/* Play icon: the poster alone does not tell that it is a video. */}
  <span
    class="absolute top-1/2 left-1/2 flex size-[44px] -translate-1/2 items-center justify-center rounded-full bg-black/60 text-white transition-transform duration-200 group-hover:scale-110 group-focus-visible:scale-110 motion-reduce:transition-none desktop:size-[calc(110*var(--u))] desktop:min-w-[56px] desktop:min-h-[56px]"
    aria-hidden="true"
  >
    <svg viewBox="0 0 24 24" class="ml-[8%] size-[45%]" fill="currentColor">
      <path d="M6 4l15 8-15 8z" />
    </svg>
  </span>
</a>

<script>
  function init() {
    document.querySelectorAll<HTMLAnchorElement>('a[data-youtube]').forEach((link) => {
      if ('ready' in link.dataset) return;
      link.dataset.ready = '';
      link.addEventListener('click', (event) => {
        event.preventDefault();
        const iframe = document.createElement('iframe');
        iframe.src = `https://www.youtube-nocookie.com/embed/${link.dataset.youtube}?autoplay=1&rel=0`;
        iframe.title = link.dataset.label ?? 'YouTube video';
        iframe.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
        iframe.allowFullscreen = true;
        iframe.className = link.className;
        iframe.setAttribute('style', link.getAttribute('style') ?? '');
        link.replaceWith(iframe);
        iframe.focus();
      });
    });
  }

  init();
  document.addEventListener('astro:page-load', init);
</script>
