---
// Loops are silent; no caption file exists yet for the videos with sound (to ask the client).
/* eslint-disable astro/jsx-a11y/media-has-caption */
import fs from 'node:fs';
import path from 'node:path';
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';

/**
 * Web video encoded by scripts/encode-videos.sh into public/videos/<name>.{webm,mp4}
 * (and <name>-m.* for screens under 1024 px when that variant exists).
 * - `loop`: silent animation, plays muted in a loop while visible (like a GIF); click pauses it.
 * - `toggle`: video with sound, a click plays or pauses it (Adobe XD "tap" behavior).
 * - `controls`: native player controls (long video with sound).
 */
interface Props {
  name: string;
  poster: ImageMetadata;
  /** Accessible name of the video. */
  label: string;
  mode?: 'loop' | 'toggle' | 'controls';
  /** Above the fold: starts loading and playing right away (`autoplay`). */
  eager?: boolean;
  /** Largest displayed width in CSS px, used to size the poster (2× for dense screens). */
  displayWidth?: number;
  /** False when another control handles pause / play (the video is then neither focusable nor clickable). */
  clickable?: boolean;
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const {
  name,
  poster,
  label,
  mode = 'loop',
  eager = false,
  displayWidth = 1920,
  clickable = true,
  class: className,
  style,
  ...attributes
} = Astro.props;

const exists = (file: string) => fs.existsSync(path.join(process.cwd(), 'public/videos', file));
if (!exists(`${name}.mp4`)) {
  throw new Error(`Missing video public/videos/${name}.mp4: run scripts/encode-videos.sh`);
}
/** WebM (lighter) is optional: browsers without it fall back to MP4. */
const hasWebm = exists(`${name}.webm`);
const hasMobile = exists(`${name}-m.mp4`);
// Posters: one sized for the desktop box, a lighter one for small screens. Only the opening video
// gets its poster in the HTML; the others receive theirs when they come near the screen.
const [posterImage, mobilePosterImage] = await Promise.all([
  getImage({ src: poster, width: Math.min(poster.width, displayWidth * 2), format: 'webp' }),
  getImage({ src: poster, width: Math.min(poster.width, 800), format: 'webp' }),
]);
const loop = mode === 'loop';
const interactive = mode !== 'controls' && clickable;

/*
 * A clickable video is wrapped with a real button over it (a <video> cannot take the button role):
 * the layout classes go to the wrapper, the object-fit / object-position ones stay on the video.
 */
const tokens = (className ?? '').split(/\s+/).filter(Boolean);
const isMediaClass = (token: string) => /(^|:)object-/.test(token);
const videoClass = tokens.filter(isMediaClass);
const wrapperClass = tokens.filter((token) => !isMediaClass(token));
const { objectPosition, ...wrapperStyle } = style ?? {};
/** The wrapper positions the button: relative, unless the caller already positions it. */
const positioned = wrapperClass.some((token) => /^(absolute|fixed|relative|sticky)$/.test(token));
---

{interactive ? (
  <span
    class:list={[wrapperClass, !positioned && 'relative', 'block overflow-hidden']}
    style={{ aspectRatio: `${poster.width} / ${poster.height}`, ...wrapperStyle }}
  >
    <video
      class:list={[videoClass, 'block size-full']}
      style={{ objectPosition }}
      poster={eager ? mobilePosterImage.src : undefined}
      data-poster={posterImage.src}
      data-poster-m={mobilePosterImage.src}
      preload={eager ? 'auto' : 'none'}
      autoplay={loop && eager}
      muted={loop}
      loop={loop}
      playsinline
      aria-hidden="true"
      data-video={mode}
      data-label={label}
      {...attributes}
    >
      {hasMobile && (
        <>
          {hasWebm && (
            <source src={`/videos/${name}-m.webm`} type="video/webm" media="(max-width: 1023px)" />
          )}
          <source src={`/videos/${name}-m.mp4`} type="video/mp4" media="(max-width: 1023px)" />
        </>
      )}
      {hasWebm && <source src={`/videos/${name}.webm`} type="video/webm" />}
      <source src={`/videos/${name}.mp4`} type="video/mp4" />
    </video>
    <button
      type="button"
      class="absolute inset-0 size-full cursor-pointer focus-visible:outline-2 focus-visible:-outline-offset-4 focus-visible:outline-current"
      aria-label={`Play: ${label}`}
      data-video-toggle
    />
  </span>
) : (
  <video
    class={className}
    style={style}
    poster={eager ? mobilePosterImage.src : undefined}
    data-poster={posterImage.src}
    data-poster-m={mobilePosterImage.src}
    preload={eager ? 'auto' : 'none'}
    autoplay={loop && eager}
    muted={loop}
    loop={loop}
    playsinline
    controls={mode === 'controls'}
    aria-label={label}
    data-video={mode}
    data-label={label}
    data-no-click=""
    {...attributes}
  >
    {hasMobile && (
      <>
        {hasWebm && (
          <source src={`/videos/${name}-m.webm`} type="video/webm" media="(max-width: 1023px)" />
        )}
        <source src={`/videos/${name}-m.mp4`} type="video/mp4" media="(max-width: 1023px)" />
      </>
    )}
    {hasWebm && <source src={`/videos/${name}.webm`} type="video/webm" />}
    <source src={`/videos/${name}.mp4`} type="video/mp4" />
  </video>
)}

<script>
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  // Silent loops only play while on screen, unless the visitor paused them or prefers less motion.
  const visibility = new IntersectionObserver(
    (entries) => {
      for (const { target, isIntersecting } of entries) {
        const video = target as HTMLVideoElement;
        if (!isIntersecting) video.pause();
        else if (!reducedMotion.matches && !('userPaused' in video.dataset)) {
          video.play().catch(() => undefined);
        }
      }
    },
    { rootMargin: '200px 0px' },
  );

  const smallScreen = window.matchMedia('(max-width: 1023px)');

  /** Sets the poster sized for the screen (the HTML only carries the opening video's small one). */
  function setPoster(video: HTMLVideoElement) {
    const src = smallScreen.matches ? video.dataset.posterM : video.dataset.poster;
    if (src && video.getAttribute('poster') !== src) video.poster = src;
  }

  const nearScreen = new IntersectionObserver(
    (entries) => {
      for (const { target, isIntersecting } of entries) {
        if (!isIntersecting) continue;
        setPoster(target as HTMLVideoElement);
        nearScreen.unobserve(target);
      }
    },
    { rootMargin: '800px 0px' },
  );

  function setUp(video: HTMLVideoElement) {
    video.dataset.ready = '';
    nearScreen.observe(video);
    const mode = video.dataset.video;
    if (mode === 'loop') {
      if (reducedMotion.matches) {
        video.removeAttribute('autoplay');
        video.pause();
      }
      visibility.observe(video);
    }
    if (mode === 'controls' || 'noClick' in video.dataset) return;

    const button = video.parentElement?.querySelector<HTMLButtonElement>('[data-video-toggle]');
    if (!button) return;
    const label = video.dataset.label ?? '';
    const sync = () =>
      button.setAttribute('aria-label', `${video.paused ? 'Play' : 'Pause'}: ${label}`);
    video.addEventListener('play', sync);
    video.addEventListener('pause', sync);
    sync();

    const toggle = () => {
      if (video.paused) {
        delete video.dataset.userPaused;
        // Only one video with sound at a time.
        if (mode === 'toggle') {
          document
            .querySelectorAll<HTMLVideoElement>('video[data-video="toggle"]')
            .forEach((other) => other !== video && other.pause());
        }
        video.play().catch(() => undefined);
      } else {
        video.dataset.userPaused = '';
        video.pause();
      }
    };
    button.addEventListener('click', toggle);
  }

  function init() {
    document
      .querySelectorAll<HTMLVideoElement>('video[data-video]:not([data-ready])')
      .forEach(setUp);
  }

  init();
  // Pages loaded by client-side navigation.
  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-swap', () => {
    visibility.disconnect();
    nearScreen.disconnect();
  });
</script>
