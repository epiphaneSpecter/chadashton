---
// Loops are silent; no caption file exists yet for the videos with sound (to ask the client).
/* eslint-disable astro/jsx-a11y/media-has-caption */
import fs from 'node:fs';
import path from 'node:path';
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';

/**
 * Web video encoded by scripts/encode-videos.sh into public/videos/<name>.{webm,mp4}
 * (and <name>-m.* for screens under 1024 px when that variant exists).
 * - `loop`: silent animation, plays muted in a loop while visible (like a GIF); click pauses it.
 * - `toggle`: video with sound, click / Enter / Space plays or pauses it (Adobe XD "tap" behavior).
 * - `controls`: native player controls (long video with sound).
 */
interface Props {
  name: string;
  poster: ImageMetadata;
  /** Accessible name of the video. */
  label: string;
  mode?: 'loop' | 'toggle' | 'controls';
  /** Above the fold: starts loading and playing right away (`autoplay`). */
  eager?: boolean;
  /** Largest displayed width in CSS px, used to size the poster (2× for dense screens). */
  displayWidth?: number;
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const {
  name,
  poster,
  label,
  mode = 'loop',
  eager = false,
  displayWidth = 1920,
  class: className,
  style,
} = Astro.props;

const exists = (file: string) => fs.existsSync(path.join(process.cwd(), 'public/videos', file));
if (!exists(`${name}.mp4`) || !exists(`${name}.webm`)) {
  throw new Error(`Missing video public/videos/${name}.{mp4,webm}: run scripts/encode-videos.sh`);
}
const hasMobile = exists(`${name}-m.mp4`) && exists(`${name}-m.webm`);
const posterImage = await getImage({
  src: poster,
  width: Math.min(poster.width, displayWidth * 2),
  format: 'webp',
});
const loop = mode === 'loop';
const interactive = mode !== 'controls';
---

<video
  class:list={[className, interactive && 'cursor-pointer']}
  style={style}
  poster={posterImage.src}
  preload={eager ? 'auto' : 'none'}
  autoplay={loop && eager}
  muted={loop}
  loop={loop}
  playsinline
  controls={mode === 'controls'}
  role={interactive ? 'button' : undefined}
  tabindex={interactive ? 0 : undefined}
  aria-label={label}
  data-video={mode}
  data-label={label}
>
  {hasMobile && (
    <>
      <source src={`/videos/${name}-m.webm`} type="video/webm" media="(max-width: 1023px)" />
      <source src={`/videos/${name}-m.mp4`} type="video/mp4" media="(max-width: 1023px)" />
    </>
  )}
  <source src={`/videos/${name}.webm`} type="video/webm" />
  <source src={`/videos/${name}.mp4`} type="video/mp4" />
</video>

<script>
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  // Silent loops only play while on screen, unless the visitor paused them or prefers less motion.
  const visibility = new IntersectionObserver(
    (entries) => {
      for (const { target, isIntersecting } of entries) {
        const video = target as HTMLVideoElement;
        if (!isIntersecting) video.pause();
        else if (!reducedMotion.matches && !('userPaused' in video.dataset)) {
          video.play().catch(() => undefined);
        }
      }
    },
    { rootMargin: '200px 0px' },
  );

  function setUp(video: HTMLVideoElement) {
    video.dataset.ready = '';
    const mode = video.dataset.video;
    if (mode === 'controls') return;

    const label = video.dataset.label ?? '';
    const sync = () =>
      video.setAttribute('aria-label', `${video.paused ? 'Play' : 'Pause'}: ${label}`);
    video.addEventListener('play', sync);
    video.addEventListener('pause', sync);
    sync();

    const toggle = () => {
      if (video.paused) {
        delete video.dataset.userPaused;
        // Only one video with sound at a time.
        if (mode === 'toggle') {
          document
            .querySelectorAll<HTMLVideoElement>('video[data-video="toggle"]')
            .forEach((other) => other !== video && other.pause());
        }
        video.play().catch(() => undefined);
      } else {
        video.dataset.userPaused = '';
        video.pause();
      }
    };
    video.addEventListener('click', toggle);
    video.addEventListener('keydown', (event) => {
      if (event.key === 'Enter' || event.key === ' ') {
        event.preventDefault();
        toggle();
      }
    });

    if (mode === 'loop') {
      if (reducedMotion.matches) {
        video.removeAttribute('autoplay');
        video.pause();
      }
      visibility.observe(video);
    }
  }

  function init() {
    document
      .querySelectorAll<HTMLVideoElement>('video[data-video]:not([data-ready])')
      .forEach(setUp);
  }

  init();
  // Pages loaded later by client-side navigation (step 8).
  document.addEventListener('astro:page-load', init);
</script>
